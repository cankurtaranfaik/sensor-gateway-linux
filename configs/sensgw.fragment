# Applied on top of Buildroot's qemu_aarch64_virt_defconfig (see scripts/configure.sh)

# prebuilt Bootlin toolchain, saves ~20 min of CI time
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y

BR2_TARGET_GENERIC_HOSTNAME="sensgw"
BR2_TARGET_GENERIC_ISSUE="sensor-gateway-linux"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SENSGW_PATH)/board/sensgw/rootfs-overlay"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SENSGW_PATH)/board/sensgw/linux.fragment"

BR2_PACKAGE_VIMU=y
BR2_PACKAGE_TELEMD=y

BR2_CCACHE=y
BR2_CCACHE_DIR="$(HOME)/.buildroot-ccache"
BR2_DL_DIR="$(HOME)/.buildroot-dl"
